<Window x:Class="WpfApp7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfApp7="clr-namespace:WpfApp7"
        mc:Ignorable="d"
        Title="Текстовый редактор"
        Height="750"
        Width="700"
        WindowStartupLocation="CenterScreen">
    <Window.CommandBindings>
        <CommandBinding Command="Open" Executed="OpenExecuted" />
        <CommandBinding Command="Save" Executed="SaveExecuted" />
        <CommandBinding Command="wpfApp7:AppCommands.SaveAs" Executed="SaveAsExecuted" />
        <CommandBinding Command="Close" Executed="ExitExecuted" />
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top" VerticalAlignment="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open" Command="Open" />
                <MenuItem Header="Save" Command="Save" />
                <MenuItem Command="wpfApp7:AppCommands.SaveAs" />
                <Separator />
                <MenuItem Header="Exit" Command="Close" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Undo" Command="Undo" />
                <MenuItem Header="Redo" Command="Redo" />
                <MenuItem Header="Copy" Command="Copy" />
                <MenuItem Header="Past" Command="Paste" />
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <ToolBarTray Grid.Row="0">
                <ToolBar Margin="5" Padding="5">
                    <Grid VerticalAlignment=" Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  Margin="5"
                                  Padding="5"
                                  SelectedIndex="0"
                                  Width="200"
                                  FontSize="16"
                                  IsEditable="True"
                                  SelectionChanged="FontFamily_OnSelectionChanged">
                            <TextBlock Text="Arial" />
                            <TextBlock Text="Times New Roman" />
                            <TextBlock Text="Verdana" />
                        </ComboBox>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  Margin="5"
                                  Padding="5"
                                  SelectedIndex="1"
                                  Width="50"
                                  FontSize="16"
                                  SelectionChanged="FontSize_OnSelectionChanged">
                            <TextBlock Text="12" />
                            <TextBlock Text="14" />
                            <TextBlock Text="16" />
                            <TextBlock Text="20" />
                            <TextBlock Text="22" />
                        </ComboBox>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Шрифт"
                                   FontSize="10"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0"
                                   Grid.ColumnSpan="2" />
                    </Grid>
                </ToolBar>
                <ToolBar Margin="5" Padding="5">
                    <Grid VerticalAlignment=" Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Row="0" Grid.Column="0"
                                      BorderThickness="0"
                                      Margin="2"
                                      Background="Transparent"
                                      Click="SetTextBold_OnClick">
                            <Image Source="Resource/iconBold.png" />
                        </ToggleButton>
                        <ToggleButton Grid.Row="0" Grid.Column="1"
                                      BorderThickness="0"
                                      Margin="2"
                                      Background="Transparent"
                                      Click="SetTextItalic_OnClick">
                            <Image Source="Resource/iconItalic.png" />
                        </ToggleButton>
                        <ToggleButton Grid.Row="0" Grid.Column="2"
                                      BorderThickness="0"
                                      Margin="2"
                                      Background="Transparent"
                                      Click="SetTextUnderline_OnClick">
                            <Image Source="Resource/iconUnder.png" />
                        </ToggleButton>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Стиль"
                                   FontSize="10"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0"
                                   Grid.ColumnSpan="3" />
                    </Grid>
                </ToolBar>
                <ToolBar Margin="5">
                    <Grid VerticalAlignment=" Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="5,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <RadioButton Grid.Row="0"
                                         IsChecked="True"
                                         Margin="2"
                                         Checked="SetTextBlack_OnChecked">
                                <TextBlock Text="Черный" />
                            </RadioButton>
                            <RadioButton Grid.Row="1"
                                         Margin="2"
                                         Checked="SetTextRed_OnChecked">
                                <TextBlock Text="Красный" />
                            </RadioButton>
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Цвет"
                                   FontSize="10"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0" />
                    </Grid>
                </ToolBar>
            </ToolBarTray>
            <Separator Grid.Row="0" VerticalAlignment="Bottom" />
            <TextBox Grid.Row="1" x:Name="TextBox"
                     FontSize="14"
                     Margin="5"
                     Padding="5"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</Window>