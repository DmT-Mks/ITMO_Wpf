<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:collections="clr-namespace:System.Collections;assembly=mscorlib"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <collections:ArrayList x:Key="Fonts">
        <system:String>Arial</system:String>
        <system:String>Times New Roman</system:String>
        <system:String>Verdana</system:String>
    </collections:ArrayList>
    
    <collections:ArrayList x:Key="TextSizes">
        <system:String>12</system:String>
        <system:String>14</system:String>
        <system:String>16</system:String>
        <system:String>20</system:String>
        <system:String>24</system:String>
    </collections:ArrayList>
</ResourceDictionary>