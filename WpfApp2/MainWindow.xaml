<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Калькулятор"
        SizeToContent="Height"
        MinHeight="370"
        Width="350"
        MinWidth="250"
        Background="WhiteSmoke"
        BorderBrush="Black"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border
            BorderThickness="1"
            BorderBrush="Black"
            Padding="5"
            Margin="5"
            Background="LightSkyBlue"
            CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Height="75"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Background="White"
                    Margin="0,5,0,5">
                    <TextBlock
                        Text="12345,678"
                        Height="Auto"
                        FontSize="32"
                        TextAlignment="Right"
                        Padding="0 2 5 2 "
                        VerticalAlignment="Bottom" />
                </Border>
                <UniformGrid
                    Grid.Row="1"
                    Columns="4"
                    Rows="6"
                    Width="Auto"
                    Height="Auto">
                    <Button
                        Content="%"
                        FontSize="20"
                        BorderThickness="1 1  2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="C"
                        FontSize="20"
                        BorderThickness="2 1 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="CE"
                        FontSize="20"
                        BorderThickness="2 1 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="←"
                        FontSize="30"
                        BorderThickness="2 1 1 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="1/x"
                        FontSize="20"
                        BorderThickness="1 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="x²"
                        FontSize="20"
                        BorderThickness="2 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="√x"
                        FontSize="20"
                        BorderThickness="2 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="÷"
                        FontSize="30"
                        BorderThickness="2 2 1 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="7"
                        FontSize="20"
                        BorderThickness="1 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="8"
                        FontSize="20"
                        BorderThickness="2 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="9"
                        FontSize="20"
                        BorderThickness="2 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="×"
                        FontSize="30"
                        BorderThickness="2 2 1 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="4"
                        FontSize="20"
                        BorderThickness="1 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="5"
                        FontSize="20"
                        BorderThickness="2 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="6"
                        FontSize="20"
                        BorderThickness="2 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="-"
                        FontSize="30"
                        BorderThickness="2 2 1 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="1"
                        FontSize="20"
                        BorderThickness="1 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="2"
                        FontSize="20"
                        BorderThickness="2 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="3"
                        FontSize="20"
                        BorderThickness="2 2 2 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="+"
                        FontSize="30"
                        BorderThickness="2 2 1 2"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="+/-"
                        FontSize="20"
                        BorderThickness="1 2 2 1"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="0"
                        FontSize="20"
                        BorderThickness="2 2 2 1"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content=","
                        FontSize="20px"
                        BorderThickness="2 2 2 1"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                    <Button
                        Content="="
                        FontSize="30"
                        BorderThickness="2 2 1 1"
                        BorderBrush="Black"
                        Background="LightSlateGray" />
                </UniformGrid>
            </Grid>
        </Border>
    </DockPanel>
</Window>