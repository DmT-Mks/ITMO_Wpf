<Window x:Class="WpfApp5._1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="850" Width="750">
    <DockPanel>
        <Menu DockPanel.Dock="Top" VerticalAlignment="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open" Click="MenuItem_Open" />
                <MenuItem Header="Save" Click="MenuItem_Save" />
                <MenuItem Header="Save As" Click="MenuItem_SaveAs" />
                <MenuItem Header="Export to PNG" Click="MenuItem_ExportToPng" />
                <Separator />
                <MenuItem Header="Exit" Click="MenuItem_Exit" />
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <ToolBarTray Grid.Row="0">
                <ToolBar Margin="5" Padding="5">
                    <Grid VerticalAlignment=" Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  Name="DrawSizes"
                                  Margin="5"
                                  Padding="5"
                                  SelectedIndex="1"
                                  Width="50"
                                  FontSize="16"
                                  SelectionChanged="DrawThickness_OnSelectionChanged">
                            <TextBlock Text="2" />
                            <TextBlock Text="4" />
                            <TextBlock Text="6" />
                            <TextBlock Text="8" />
                            <TextBlock Text="10" />
                        </ComboBox>
                        <ToggleButton Grid.Row="0" Grid.Column="1"
                                      Name="ButtonDraw"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Margin="2"
                                      Click="SetEditingModeInk_OnClick"
                                      IsChecked="True">
                            <Image Source="Resources/drawIcon.png" />
                        </ToggleButton>
                        <ComboBox Grid.Row="0" Grid.Column="2"
                                  Name="EraseSizes"
                                  Margin="20,5,5,5"
                                  Padding="5"
                                  SelectedIndex="1"
                                  Width="50"
                                  FontSize="16"
                                  Background="Transparent"
                                  SelectionChanged="EraseThickness_OnSelectionChanged">
                            <TextBlock Text="2" />
                            <TextBlock Text="4" />
                            <TextBlock Text="6" />
                            <TextBlock Text="8" />
                            <TextBlock Text="10" />
                            <TextBlock Text="15" />
                            <TextBlock Text="30" />
                        </ComboBox>
                        <ToggleButton Grid.Row="0" Grid.Column="3"
                                      Name="ButtonErase"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Margin="2"
                                      Click="SetEditingModeEraseByPoint_OnClick">
                            <Image Source="Resources/eraser.png" />
                        </ToggleButton>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Инструменты"
                                   FontSize="10"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,1,0,0"
                                   Grid.ColumnSpan="4" />
                    </Grid>
                </ToolBar>
            </ToolBarTray>
            <Separator Grid.Row="0" VerticalAlignment="Bottom" />
            <Border Grid.Row="1" Margin="5" BorderThickness="1" BorderBrush="Gray">
                <InkCanvas Name="InkCanvas" Background="White">
                    <InkCanvas.DefaultDrawingAttributes>
                        <DrawingAttributes Color="Black" Width="4" Height="4" />
                    </InkCanvas.DefaultDrawingAttributes>
                </InkCanvas>
            </Border>
        </Grid>
    </DockPanel>
</Window>